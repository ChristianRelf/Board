# Postgres
DATABASE_URL=postgres://board:board@localhost:5432/board

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://trello.chrisrelf.xyz
AUTH_TRUST_HOST=true

# Discord application -> OAuth2
# Redirect URI: https://trello.chrisrelf.xyz/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Comma-separated Discord user IDs allowed to sign in. Empty = anyone with the link.
ALLOWED_DISCORD_IDS=

# Where attachments live on disk
UPLOAD_DIR=./uploads
NEXT_PUBLIC_APP_URL=https://trello.chrisrelf.xyz
